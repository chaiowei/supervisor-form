        "jsonBody": "={{ { name: $('Prepare Folder').first().json.folderName, mimeType: 'application/vnd.google-apps.folder', parents: [$('Prepare Folder').first().json.parentId] } }}",
        "options": {}
      },
      "name": "Drive: Create Project Folder",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        880,
        140
      ],
      "credentials": {
        "googleDriveOAuth2Api": {
          "id": "tHegGlDXg7LOneTk",
          "name": "Google Drive account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// The form sends one compressed JPEG per request as base64 (same shape it\n// used to send imgBB), plus a suggested file name and the project name.\n// Input here is either the folder search result or the newly created folder.\nconst folder = $input.first().json;\nconst folderId = folder.files ? folder.files[0].id : folder.id;\nif (!folderId) throw new Error('no project folder id');\nconst body = $('Webhook (Photo)').first().json.body || $('Webhook (Photo)').first().json;\nconst b64 = String(body.image || '');\nif (!b64) throw new Error('no image in request');\nconst safe = s => String(s || '').replace(/[\\\\/:*?\"<>|]/g, '_').slice(0, 80);\nconst fileName = safe(body.fileName) || `photo_${Date.now()}.jpg`;\nconst binary = await this.helpers.prepareBinaryData(Buffer.from(b64, 'base64'), fileName, 'image/jpeg');\nreturn [{ json: { fileName, folderId }, binary: { data: binary } }];"
      },
