    {
      "parameters": {
        "jsCode": "// Photos are filed in a sub-folder per project (工程名稱) inside the main photo\n// folder. A report can cover several projects (\"A, B\"); its photos go into the\n// first project's folder. No project → 未分類.\nconst PARENT_ID = '18jWzLPIqYVXvmOgnoPYGC9Imbf8xxExd';\nconst body = $input.first().json.body || $input.first().json;\nconst first = String(body.projectName || '').split(', ').map(s => s.trim()).filter(Boolean)[0];\nconst folderName = (first || '未分類').replace(/[\\\\/]/g, '_').slice(0, 100);\n// Escape for the Drive search query string\nconst esc = folderName.replace(/\\\\/g, '\\\\\\\\').replace(/'/g, \"\\\\'\");\nconst q = `mimeType='application/vnd.google-apps.folder' and name='${esc}' and '${PARENT_ID}' in parents and trashed=false`;\nreturn [{ json: { folderName, parentId: PARENT_ID, q } }];"
      },
      "name": "Prepare Folder",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        0
      ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "https://www.googleapis.com/drive/v3/files",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "googleDriveOAuth2Api",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "q",
              "value": "={{ $json.q }}"
            },
            {
