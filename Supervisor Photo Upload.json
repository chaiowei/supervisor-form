        "jsCode": "// The form sends one compressed JPEG per request as base64 (same shape it\n// used to send imgBB), plus a suggested file name.\nconst body = $input.first().json.body || $input.first().json;\nconst b64 = String(body.image || '');\nif (!b64) throw new Error('no image in request');\nconst safe = s => String(s || '').replace(/[\\\\/:*?\"<>|]/g, '_').slice(0, 80);\nconst fileName = safe(body.fileName) || `photo_${Date.now()}.jpg`;\nconst binary = await this.helpers.prepareBinaryData(Buffer.from(b64, 'base64'), fileName, 'image/jpeg');\nreturn [{ json: { fileName }, binary: { data: binary } }];"
      },
